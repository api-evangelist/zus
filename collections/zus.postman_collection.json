              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/patient-history/jobs",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "patient-history",
                "jobs"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Submit a Patient History job to retrieve external data into the ZAP. Sets Patient.active=true."
          }
        },
