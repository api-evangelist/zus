              ]
            },
            "description": "List Patient History jobs."
          }
        },
        {
          "name": "Retrieve a Patient History job.",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/patient-history/jobs/:jobId",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "patient-history",
                "jobs",
                ":jobId"
              ],
              "variable": [
                {
                  "key": "jobId",
                  "value": ""
                }
              ]
            },
            "description": "Retrieve a Patient History job by id."
          }
        }
      ]
    },
    {
      "name": "Documents",
      "item": [
