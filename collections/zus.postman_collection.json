          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/fhir+json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/fhir/DocumentReference/:id",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "fhir",
                "DocumentReference",
                ":id"
              ],
              "variable": [
                {
                  "key": "id",
                  "value": ""
                }
              ]
            },
            "description": "Read a FHIR R4 DocumentReference. Narrative text.div is treated as opaque."
          }
        },
        {
          "name": "Read a Binary resource by id.",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/fhir+json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/fhir/Binary/:id",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "fhir",
