        {
          "id": "e4863cdb-70ac-46ce-8a57-e84c4e55c0c8",
          "name": "Issue or exchange an OAuth2 access token.",
          "request": {
            "name": "Issue or exchange an OAuth2 access token.",
            "description": {
              "content": "Exchange credentials for a Zus access token. Supports the authorization_code (with PKCE) grant and the RFC 8693 token-exchange grant (grant_type urn:ietf:params:oauth:grant-type:token-exchange) for exchanging a third-party IdP ID token. Access tokens are valid for one hour (expires_in 3600). The token endpoint is rate limited to 200 requests per hour per App Client.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "oauth",
                "token"
              ],
              "host": [
                "{{oauth-token-Url}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "disabled": false,
                  "key": "grant_type",
                  "value": "<string>",
                  "description": "(Required) authorization_code or urn:ietf:params:oauth:grant-type:token-exchange."
                },
                {
                  "disabled": false,
                  "key": "client_id",
                  "value": "<string>"
                },
                {
